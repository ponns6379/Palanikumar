# ---------------------------------------------------------------
# Copy to .env.local (local) or add as environment variables (hosting)
# ---------------------------------------------------------------

# REQUIRED in production. 32+ random characters. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=

# Public URL of the website (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# PostgreSQL connection string (Supabase, Neon, RDS, local Postgres ...).
# If this is EMPTY the site uses an embedded local Postgres (PGlite) stored in ./.data
# which is perfect for trying the site locally but NOT for Vercel/serverless.
DATABASE_URL=
# Set to "false" for a local Postgres without SSL
DATABASE_SSL=

# Load the Bio-Data content automatically the first time the database is empty
# (set to "false" if you prefer to run `npm run db:seed` yourself)
AUTO_SEED=true

# ---- File uploads --------------------------------------------------
# Option A (VPS / Docker / local): files are stored on disk here (mount a persistent volume)
UPLOAD_DIR=./uploads
# Option B (Vercel / serverless): Supabase Storage (create a PUBLIC bucket first)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=site-uploads
